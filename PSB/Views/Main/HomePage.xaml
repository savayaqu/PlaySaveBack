<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PSB.Views.HomePage"
    x:Name="homePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PSB.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PSB.ViewModels"
    xmlns:models="using:PSB.Models"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка с последней игрой -->
        <Grid Grid.Row="0" 
              Margin="24,16"
              Padding="10"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1"
              Visibility="{x:Bind HomeViewModel.LastPlayedGameExists, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
              CornerRadius="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Иконка игры -->
            <Border Grid.Column="0"
                    Width="32"
                    Height="32"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="4"
                    Margin="0,0,16,0">
                <ContentControl Content="{x:Bind HomeViewModel.GameIcon, Mode=OneWay}"/>
            </Border>

            <!-- Информация о последней игре -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                <TextBlock Text="Последняя запущенная игра"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="{x:Bind HomeViewModel.LastPlayedGame.Game.Name}"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Margin="0,4,0,0"/>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <TextBlock Text="{x:Bind HomeViewModel.LastPlayedGame.Library.LastPlayedText}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="•"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Text="{x:Bind HomeViewModel.LastPlayedGame.Library.TimePlayed, Converter={StaticResource TimePlayedConverter}}"
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="•"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind HomeViewModel.LastPlayedGame.Library.LastPlayedAt}"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Visibility="{x:Bind HomeViewModel.LastPlayedGameExists, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Grid.Column="2" Padding="16,8" VerticalAlignment="Center" Orientation="Horizontal" Spacing="12">
                <Button Style="{StaticResource AccentButtonStyle}" Content="Перейти к игре"  Command="{x:Bind HomeViewModel.SelectGameCommand, Mode=OneWay}" CommandParameter="{x:Bind HomeViewModel.LastPlayedGame.Game}"/>
                <!-- Кнопка "Играть" -->
                <Button Width="150" Height="40" Style="{StaticResource PlayButtonStyle}"  Command="{x:Bind GameViewModel.LaunchGameCommand, Mode=OneTime}" Visibility="{x:Bind GameViewModel.InLibrary, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=False}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" FontSize="20"/>
                        <TextBlock Text="ИГРАТЬ" FontWeight="Bold" />
                    </StackPanel>
                </Button>
                
            </StackPanel>
            
        </Grid>

        <!-- Основной контент -->
        <Grid Grid.Row="1" Margin="24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок раздела -->
            <StackPanel Grid.Row="0" Orientation="Vertical" Spacing="12" Margin="0,0,0,16">
                <TextBlock Text="Локальные сохранения"
                           Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" 
                           Text="У вас нет несинхронизированных сохранений"
                           Visibility="{x:Bind HomeViewModel.LocalSavesExists, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}"/>
            </StackPanel>

            <!-- Список сохранений -->
            <ScrollViewer Grid.Row="1" Visibility="{x:Bind HomeViewModel.LocalSavesExists, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl ItemsSource="{x:Bind HomeViewModel.LocalSaves, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:GroupedSaves">
                            <Expander Margin="0,0,0,12"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                      BorderThickness="1"
                                      CornerRadius="8">
                                <Expander.Header>
                                    <Grid Padding="12"
                                          Background="Transparent"
                                          ColumnSpacing="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <ContentControl Grid.Column="0"
                                                    Content="{x:Bind GameIcon, Mode=OneWay}"
                                                    Margin="0,0,12,0"/>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Game.Name}"
                                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                                <Run Text="Сохранений: "/>
                                                <Run Text="{x:Bind Saves.Count}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Content="Перейти к игре"
                                                Command="{Binding ElementName=homePage, Path=HomeViewModel.SelectGameCommand}"
                                                CommandParameter="{Binding Game}"
                                                Style="{StaticResource AccentButtonStyle}"
                                                />
                                    </Grid>
                                </Expander.Header>

                                <ListView ItemsSource="{x:Bind Saves}"
                                          SelectionMode="None"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ItemContainerStyle="{StaticResource ListViewItemRevealStyle}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:Save">
                                            <Grid Padding="12,8"
                                                  Background="Transparent" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <SymbolIcon Grid.Column="0"
                                                            Symbol="Save"
                                                            Margin="0,0,12,0"/>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{x:Bind FileName}"
                                                               Style="{StaticResource BodyTextBlockStyle}"/>
                                                    <TextBlock Text="{x:Bind CreatedAt}"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            Spacing="8">
                                                       <TextBlock Text="{x:Bind Size, Converter={StaticResource BytesToSizeConverter}}"
                                                                  Style="{StaticResource CaptionTextBlockStyle}"
                                                                  Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                                       <FontIcon Glyph="&#xE72C;"
                                                                 Foreground="{x:Bind SyncIconColor}"/>
                                                </StackPanel>

                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>