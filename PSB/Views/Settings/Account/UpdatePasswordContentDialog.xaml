<ContentDialog
    x:Class="PSB.Views.Settings.Account.UpdatePasswordContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PSB.Views.Settings.Account"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Title="Обновление пароля" CornerRadius="10">
    <StackPanel Spacing="16">
        <!-- Close button -->
        <Button 
    BorderThickness="0" 
    Background="Transparent" 
    HorizontalAlignment="Right" 
    VerticalAlignment="Top" 
    Margin="0,-35,0,0" 
    Click="Button_Click"
    ToolTipService.ToolTip="Закрыть">
            <FontIcon Glyph="&#xE711;" FontSize="12"/>
        </Button>
        <StackPanel Orientation="Horizontal" CornerRadius="5" Spacing="12" Padding="8">
            <Image Stretch="Fill" Height="50" Width="50" Source="{x:Bind UpdatePasswordViewModel.User.Avatar, Mode=OneWay}"/>
            <StackPanel VerticalAlignment="Center" >
                <TextBlock Text="{x:Bind UpdatePasswordViewModel.User.Nickname}"/>
                <TextBlock Text="{x:Bind UpdatePasswordViewModel.User.Login}"/>
            </StackPanel>
        </StackPanel>
        <HyperlinkButton x:Name="nav" Click="Nav_Click"  Content="Хотите обновить почту?"/>
        <!-- Текущий пароль -->
        <PasswordBox Width="300" 
             PlaceholderText="Текущий пароль" 
             Password="{x:Bind UpdatePasswordViewModel.CurrentPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             PasswordChanged="PasswordBox_PasswordChanged"/>
        <!-- Новый пароль -->
        <PasswordBox Width="300" 
             PlaceholderText="Новый пароль" 
             Password="{x:Bind UpdatePasswordViewModel.NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             PasswordChanged="NewPassword_PasswordChanged"/>
        
        <TextBlock Width="300" Text="{x:Bind UpdatePasswordViewModel.ErrorNewPass, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Visibility="{x:Bind UpdatePasswordViewModel.ErrorNewPass, Converter={StaticResource EmptyToVisibilityConverter},Mode=OneWay}"
                   Foreground="{StaticResource SystemFillColorAttentionBrush}"/>
        <!-- Подтверждение пароля -->
        <PasswordBox Width="300" 
             PlaceholderText="Подтвердите ваш пароль" 
             Password="{x:Bind UpdatePasswordViewModel.NewPasswordConfirmation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             PasswordChanged="ConfirmPassword_PasswordChanged"/>
        
        <TextBlock Width="300" Text="{x:Bind UpdatePasswordViewModel.ErrorNewPassConf, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Visibility="{x:Bind UpdatePasswordViewModel.ErrorNewPassConf, Converter={StaticResource EmptyToVisibilityConverter},Mode=OneWay}"
                   Foreground="{StaticResource SystemFillColorAttentionBrush}"/>

        <TextBlock Width="300" Text="{x:Bind UpdatePasswordViewModel.Error, Mode=OneWay}"
                   TextWrapping="Wrap"
                   Visibility="{x:Bind UpdatePasswordViewModel.Error, Converter={StaticResource EmptyToVisibilityConverter},Mode=OneWay}"
                   Foreground="{StaticResource SystemFillColorAttentionBrush}"/>
        
        <Button HorizontalAlignment="Center" Content="Обновить пароль" Command="{x:Bind UpdatePasswordViewModel.UpdatePasswordCommand, Mode=OneTime}"/>
    </StackPanel>
</ContentDialog>